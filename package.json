{
  "name": "drivex",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/neon/server.mjs",
    "dev": "node --env-file-if-exists=.env backend/neon/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/generate-config.mjs --neon",
    "check": "node scripts/check.mjs",
    "deploy:smoke": "node scripts/check-deployment.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "db:plan": "node --env-file-if-exists=.env backend/neon/migrate.mjs --dry-run",
    "db:migrate": "node --env-file-if-exists=.env backend/neon/migrate.mjs --apply",
    "start:neon": "node --env-file-if-exists=.env backend/neon/server.mjs",
    "notifications:run": "node --env-file-if-exists=.env backend/neon/run-notifications.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
}
